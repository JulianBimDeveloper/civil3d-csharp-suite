<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>XTS_Evolution_PB</AssemblyName>
    
    <AssemblyTitle>XTS Evolution Civil 3D 2025 (PocketBase)</AssemblyTitle>
    <Company>Arq. Julian Mejia</Company>
    <Product>XTS Suite PB</Product>
    <Description>BIM Metadata Sync for PocketBase</Description>
    <Copyright>Copyright © 2026 Arq. Julian Mejia</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <OutputPath>..\..\..\..\ADDINS\civil3d\DLL\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Loader.cs" />
  </ItemGroup>

  <ItemGroup>
